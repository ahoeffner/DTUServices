{
  "id": "dtu-services",
  "realm": "dtu-services",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "dtu-services",
      "secret": "Manager1",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email"
      ],
      "webOrigins": [
        "*"
      ],
      "redirectUris": [
        "*"
      ],
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "policies": [
          {
            "name": "Allow Self Exchange",
            "type": "client",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "clients": "[\"dtu-services\"]"
            }
          }
        ]
      }
    }
  ],
  "users": [
    {
      "enabled": true,
      "username": "test",
      "email": "test@nowhere.dtu",
      "firstName": "Test",
      "lastName": "User",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Manager1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "metrics",
        "books:all"
      ]
    }
  ]
}     