read -p "Username: " username
read -sp "Password: " password

curl -X POST http://localhost:9002/realms/dtu-services/protocol/openid-connect/token \
 -H "Content-Type: application/x-www-form-urlencoded" \
 -d "client_id=dtu-services" \
 -d "username=$username" \
 -d "password=$password" \
 -d "grant_type=password" \
 -d "client_secret=$password"
